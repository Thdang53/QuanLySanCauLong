<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootArenaContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF4F3">

    <!-- ==================== NỘI DUNG CUỘN CHÍNH (HEADER CONG + BODY ĐÈ LÊN -30DP) ==================== -->
    <ScrollView
        android:id="@+id/scrollMainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="118dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER CONG EMERALD (.hd) ĐỒNG BỘ 100% VỚI MẪU -->
            <FrameLayout
                android:id="@+id/layoutHeaderCurved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_curved_emerald"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="52dp">

                <!-- Hình lưới sân cầu lông вектор góc phải dưới -->
                <ImageView
                    android:layout_width="175dp"
                    android:layout_height="105dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-8dp"
                    android:layout_marginBottom="-28dp"
                    android:alpha="0.65"
                    android:contentDescription="Sân cầu lông"
                    android:scaleType="fitEnd"
                    android:src="@drawable/ic_header_court_art" />

                <!-- Cụm nút góc phải trên: Mặt trăng + Đăng xuất -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnHeaderTheme"
                        android:layout_width="40dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tag_translucent"
                        android:gravity="center"
                        android:text="🌙"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnHeaderLogout"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_tag_translucent"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Đăng xuất"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tiêu đề lớn + Phụ đề + Thanh kính mờ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="255dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingExtra="2dp"
                        android:text="Bạn muốn chơi&#10;sân nào?"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeaderSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Davies Arena • Đặt sân nhanh, cọc 30% qua VietQR"
                        android:textColor="#E6FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvHeaderGlass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_tag_translucent"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp"
                        android:text="🔎 Chọn sân, ngày và khung giờ bên dưới"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- VÙNG THẺ NỘI DUNG ĐÈ LÊN HEADER (-32DP GIỐNG HỆT .pad TRONG MẪU) -->
            <LinearLayout
                android:id="@+id/containerDynamicBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-32dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp" />

        </LinearLayout>
    </ScrollView>

    <!-- ==================== THANH BOTTOM NAV NỔI CÓ BONG BÓNG TRÒN XANH (.u041) ==================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Lớp nền che khe hở dưới đáy để chữ cuộn không bị lộ cắt ngang dưới thanh điều hướng -->
        <View
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_gravity="bottom"
            android:background="#EEF4F3" />

        <!-- Thanh nền trắng bo tròn 28dp ở dưới -->
        <View
            android:id="@+id/viewBottomBarBg"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_bottom_nav"
            android:elevation="8dp" />

        <!-- 4 Ô Tab (3 ô cho Khách/Nhân viên, 4 ô cho Chủ sân) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="12dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="8dp">

            <!-- TAB 0 -->
            <FrameLayout
                android:id="@+id/navSlot0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/navBubble0"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_nav_bubble_emerald"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:text="⊞"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/navIcon0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:text="⊞"
                    android:textColor="#6B7280"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/navLabel0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:text="Đặt sân"
                    android:textColor="#1F2937"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- TAB 1 -->
            <FrameLayout
                android:id="@+id/navSlot1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/navBubble1"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_nav_bubble_emerald"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:text="📅"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/navIcon1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:text="📅"
                    android:textColor="#6B7280"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/navBadge1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/bg_btn_red_pill"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/navLabel1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:text="Lịch đặt"
                    android:textColor="#1F2937"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- TAB 2 -->
            <FrameLayout
                android:id="@+id/navSlot2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/navBubble2"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_nav_bubble_emerald"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:text="👤"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/navIcon2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:text="👤"
                    android:textColor="#6B7280"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/navLabel2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:text="Tài khoản"
                    android:textColor="#1F2937"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- TAB 3 (Chỉ hiện ở Role Chủ sân / Admin) -->
            <FrameLayout
                android:id="@+id/navSlot3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone">

                <TextView
                    android:id="@+id/navBubble3"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_nav_bubble_emerald"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:text="📦"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/navIcon3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:text="📦"
                    android:textColor="#6B7280"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/navLabel3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:text="Kho"
                    android:textColor="#1F2937"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
