<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="12dp">

    <!-- Cột giờ Timeline bên trái (giống Hình 2 giữa) -->
    <TextView
        android:id="@+id/tvTimelineHour"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:text="18:00"
        android:textColor="@color/text_muted"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <!-- Chấm tròn Timeline -->
    <TextView
        android:id="@+id/tvTimelineDot"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="●"
        android:textColor="@color/davies_primary"
        android:textSize="12sp" />

    <!-- Khối Pill màu sắc bo tròn giống Hình 2 -->
    <LinearLayout
        android:id="@+id/boxTimelinePill"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_pill_teal"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="11dp"
        android:paddingEnd="14dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTimelineTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sân 1 • Minh Khang"
                android:textColor="@color/text_white"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimelineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_glass"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="ĐÃ CỌC 30%"
                android:textColor="@color/text_white"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTimelineSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🕒 18:00 - 20:00  •  Cọc: 48.000đ"
            android:textColor="#F8FAFC"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
