<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06372C">

    <!-- Hình nền Sân Cầu Lông tông Xanh Ngọc (Emerald Badminton Court) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Sân cầu lông Davies Arena"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_login_emerald_court" />

    <!-- Lớp phủ nhẹ giúp chữ & khung đăng nhập ở chính giữa luôn rõ nét -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2604221B" />

    <!-- Toàn bộ Form Đăng nhập + Nút Đăng Nhập gom gọn và căn chính giữa màn hình -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingEnd="34dp">

        <!-- Tiêu đề chính Tiếng Việt -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="4dp"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="Davies Arena\nSân Cầu Lông"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:text="HỆ THỐNG ĐẶT SÂN &amp; QUẢN LÝ CẦU LÔNG"
            android:textColor="#D1FAE5"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- Ô nhập 1: Tài khoản hoặc SĐT -->
        <EditText
            android:id="@+id/edtLoginUser"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_frosted_pill"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="12dp"
            android:drawableTint="#0D6E57"
            android:elevation="3dp"
            android:hint="Tài khoản hoặc Số điện thoại"
            android:inputType="text"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#072A22"
            android:textColorHint="#4A7C6F"
            android:textSize="14sp" />

        <!-- Ô nhập 2: Mật khẩu -->
        <EditText
            android:id="@+id/edtLoginPass"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_frosted_pill"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="12dp"
            android:drawableTint="#0D6E57"
            android:elevation="3dp"
            android:hint="Mật khẩu"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#072A22"
            android:textColorHint="#4A7C6F"
            android:textSize="14sp" />

        <!-- Dòng Quên mật khẩu? căn phải ngay dưới ô Mật khẩu -->
        <TextView
            android:id="@+id/tvForgotPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="6dp"
            android:shadowColor="#60000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="Quên mật khẩu?"
            android:textColor="#ECFDF5"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- Nút Đăng Nhập đặt gần ngay dưới form -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_emerald_pill"
            android:elevation="6dp"
            android:stateListAnimator="@null"
            android:text="Đăng Nhập"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <!-- Nút Tạo Tài Khoản Mới có khung nút bo tròn giống Đăng Nhập -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegisterNow"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_emerald_secondary_pill"
            android:elevation="4dp"
            android:stateListAnimator="@null"
            android:text="Tạo Tài Khoản Mới"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
