<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_davies_gradient">

    <!-- Nút mặt trăng góc phải trên giống mẫu -->
    <TextView
        android:id="@+id/btnThemeLogin"
        android:layout_width="44dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_tag_translucent"
        android:gravity="center"
        android:text="🌙"
        android:textSize="15sp" />

    <!-- Minh họa sân cầu lông + 2 vận động viên ở đáy màn hình -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:contentDescription="Sân cầu lông Davies Arena"
        android:scaleType="fitXY"
        android:src="@drawable/ic_login_court_scene" />

    <!-- Nội dung chính căn giữa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="42dp"
        android:paddingEnd="26dp"
        android:paddingBottom="190dp">

        <!-- Logo vợt cầu lông + Tiêu đề Davies Arena -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏸"
            android:textSize="38sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-black"
            android:text="Davies Arena"
            android:textColor="#064E3B"
            android:textSize="33sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Đặt sân cầu lông nhanh, gọn, tiện"
            android:textColor="#065F46"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <!-- Khối Form Đăng nhập căn giữa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Ô nhập Tài khoản / Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_frosted_pill"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✉️"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/edtLoginUser"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Email / Tài khoản"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:textColor="#1F2937"
                    android:textColorHint="#6B7280"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <!-- Ô nhập Mật khẩu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_frosted_pill"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/edtLoginPass"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Mật khẩu"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="#1F2937"
                    android:textColorHint="#6B7280"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <!-- Quên mật khẩu? -->
            <TextView
                android:id="@+id/tvForgotPass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="Quên mật khẩu?"
                android:textColor="#064E3B"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <!-- Nút Đăng nhập màu xanh đậm #064E3B -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_emerald_pill"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                android:text="Đăng nhập"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Nút Đăng ký đồng bộ bên dưới -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegisterNow"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_emerald_secondary_pill"
                android:stateListAnimator="@null"
                android:text="Đăng ký"
                android:textAllCaps="false"
                android:textColor="#064E3B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Tài khoản demo (mật khẩu 123456) y hệt mẫu -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:text="Tài khoản demo (mật khẩu 123456):"
                android:textColor="#064E3B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipDemoCustomer"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_input_frosted_pill"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Khách hàng"
                    android:textColor="#064E3B"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipDemoStaff"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_input_frosted_pill"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Nhân viên trực quầy"
                    android:textColor="#064E3B"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipDemoAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_input_frosted_pill"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Chủ sân"
                    android:textColor="#064E3B"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
