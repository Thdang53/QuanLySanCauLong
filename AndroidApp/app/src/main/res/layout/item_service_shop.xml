<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Thẻ Món Dịch Vụ có Hình ảnh + Tên + Giá + Nút [ - ] Số lượng [ + ] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_soft_22"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Ảnh chụp/minh họa món (Chai nước suối, Revive, Cầu lông, Vợt) -->
        <androidx.cardview.widget.CardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imgServiceThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh dịch vụ"
                android:scaleType="centerCrop"
                android:src="@drawable/img_badminton_banner" />
        </androidx.cardview.widget.CardView>

        <!-- Tên món + Giá tiền + Tồn kho -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvServiceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nước suối Aquafina"
                android:textColor="#1A1F36"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServicePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="10,000đ / Chai"
                android:textColor="#059669"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServiceStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Còn: 50 Chai"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Cụm nút [ - ]  Số lượng  [ + ] trực quan -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMinusQty"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_pastel_mint"
                android:gravity="center"
                android:text="−"
                android:textColor="#059669"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectedQty"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textColor="#1A1F36"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPlusQty"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_teal"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
