<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Thẻ Sân bo tròn 22dp giống hệt thẻ "Science Technology" trong ảnh mẫu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_soft_22"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Khung ảnh sân bo góc 18dp bên trái -->
        <androidx.cardview.widget.CardView
            android:layout_width="86dp"
            android:layout_height="82dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:id="@+id/boxCourtIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_court_free">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.88"
                    android:contentDescription="Ảnh sân"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_login_emerald_court" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_white"
                    android:gravity="center"
                    android:text="🏸"
                    android:textSize="14sp" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Nội dung thông tin sân tinh gọn giống ảnh mẫu -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Hàng 1: Điểm sao (4.9 ⭐) + Nhãn trạng thái bo tròn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvItemCourtRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_gold"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="4.9 ★"
                    android:textColor="#D97706"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvItemCourtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_teal"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="Trống"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hàng 2: Tên sân đậm rõ ràng -->
            <TextView
                android:id="@+id/tvItemCourtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sân 1 • Thảm Yonex VIP"
                android:textColor="#1A1F36"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Hàng 3: Mô tả ngắn -->
            <TextView
                android:id="@+id/tvItemCourtDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ánh sáng chuẩn thi đấu"
                android:textColor="#94A3B8"
                android:textSize="11.5sp" />

            <!-- Hàng 4: Chấm tròn màu + Giá sân (giống "Bid 5.4 ETH" trong ảnh mẫu) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_circle_pastel_mint"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#059669"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Giá "
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvItemCourtPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80.000đ/h"
                    android:textColor="#1A1F36"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
