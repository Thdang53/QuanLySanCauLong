<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_category_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Ô màu biểu tượng 4 trạng thái sân -->
        <LinearLayout
            android:id="@+id/boxCourtIcon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_court_free"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏸"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- Thông tin sân -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemCourtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sân 1 • Thảm Yonex VIP"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemCourtDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ánh sáng chuẩn thi đấu"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvItemCourtRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.9 ⭐"
                    android:textColor="@color/star_gold"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  "
                    android:textColor="@color/text_light"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvItemCourtPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80.000đ/giờ"
                    android:textColor="@color/davies_primary_variant"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nhãn trạng thái Pill -->
        <TextView
            android:id="@+id/tvItemCourtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_teal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="TRỐNG"
            android:textColor="@color/text_white"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
