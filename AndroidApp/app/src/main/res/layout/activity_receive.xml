<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_receive"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Thanh tiêu đề màu tím -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#6200EE"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lab4_PS23456"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Khối nội dung chính căn giữa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!-- Dòng hiển thị thứ khách hàng cần mua -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thứ khách hàng cần mua là:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- Tên vật phẩm nhận từ Activity 1 -->
        <TextView
            android:id="@+id/txtItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF5722"
            android:layout_marginBottom="24dp" />

        <!-- Dòng yêu cầu báo giá -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hãy báo giá cho khách hàng:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#00ACC1"
            android:layout_marginBottom="8dp" />

        <!-- Ô nhập giá tiền -->
        <EditText
            android:id="@+id/edtPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hãy nhập giá"
            android:inputType="number"
            android:gravity="center"
            android:textSize="18sp"
            android:layout_marginBottom="20dp" />

        <!-- Nút BÁO GIÁ -->
        <Button
            android:id="@+id/btnQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BÁO GIÁ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6200EE"
            android:paddingHorizontal="32dp" />

    </LinearLayout>

</LinearLayout>
