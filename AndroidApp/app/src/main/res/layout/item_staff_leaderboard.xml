<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/cardLeaderboardItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_category_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Huy hiệu hạng -->
        <TextView
            android:id="@+id/tvRankMedal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_gold"
            android:gravity="center"
            android:text="🥇"
            android:textSize="22sp" />

        <!-- Thông tin & thanh tiến độ (giống Hình 2 phải) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStaffName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nguyễn Văn Hùng"
                    android:textColor="@color/text_main"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStaffScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.9 ⭐"
                    android:textColor="@color/star_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStaffComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Phục vụ rất nhiệt tình, sân sạch sẽ!"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/pbStaffRating"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="98"
                android:progressTint="@color/davies_coral" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
