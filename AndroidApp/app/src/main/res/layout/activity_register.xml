<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06372C">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Sân cầu lông Davies Arena"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_login_emerald_court" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2604221B" />

    <!-- Form Đăng ký tinh giản căn chính giữa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="Đăng ký"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtRegEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_frosted_pill"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="12dp"
            android:drawableTint="#0D6E57"
            android:hint="Số điện thoại"
            android:inputType="phone"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#072A22"
            android:textColorHint="#4A7C6F"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtRegUser"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_frosted_pill"
            android:drawableStart="@drawable/ic_person"
            android:drawablePadding="12dp"
            android:drawableTint="#0D6E57"
            android:hint="Tài khoản"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#072A22"
            android:textColorHint="#4A7C6F"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtRegPass"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_frosted_pill"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="12dp"
            android:drawableTint="#0D6E57"
            android:hint="Mật khẩu"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#072A22"
            android:textColorHint="#4A7C6F"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtRegConfirmPass"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_frosted_pill"
            android:drawableStart="@drawable/ic_lock"
            android:drawablePadding="12dp"
            android:drawableTint="#0D6E57"
            android:hint="Nhập lại mật khẩu"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#072A22"
            android:textColorHint="#4A7C6F"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegSignIn"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_emerald_pill"
            android:elevation="6dp"
            android:stateListAnimator="@null"
            android:text="Đăng ký"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegCancel"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_emerald_secondary_pill"
            android:elevation="4dp"
            android:stateListAnimator="@null"
            android:text="Đăng nhập"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</FrameLayout>
